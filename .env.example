# XCRDownloader configuration
# Copy this file to .env and adjust values as needed.

# Server settings
XCR_SERVER_HOST=127.0.0.1
XCR_SERVER_PORT=8080
XCR_DEBUG=false

# Downloads
XCR_DOWNLOAD_DIR=downloads
XCR_MAX_WORKERS=3

# Job management
XCR_JOB_TTL_SECONDS=3600
XCR_MAX_JOBS=100

# Network timeouts (seconds)
XCR_CONNECT_TIMEOUT=30
XCR_READ_TIMEOUT=30

# Logging
XCR_LOG_LEVEL=INFO

# Relay allowed hosts (comma-separated)
XCR_RELAY_ALLOWED_HOSTS=megaplay.buzz,tiktokcdn.com,ibyteimg.com,ipstatp.com,yoot.trycloud.pro,norami.top,akirax.buzz,shiora.